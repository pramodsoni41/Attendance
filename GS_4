/* ================= CONFIG DEFAULTS ================= */
const DEFAULT_ADMIN_PASS = "admin123";
const DEFAULT_QR_VALIDITY_SEC = 40;
const QR_GRACE_SEC = 10;
const QR_CACHE_TTL_SEC = 120;
const STUDENT_CACHE_TTL_SEC = 300;
const CONFIG_CACHE_TTL_SEC = 300;
const DUPLICATE_WINDOW_SEC = 1200;

/**
 * Main Web App Entry Point
 */
function doGet(e) {
  const params = e && e.parameter ? e.parameter : {};
  const type = String(params.type || "").trim().toLowerCase();
  const callback = String(params.callback || "callback").trim();

  try {
    switch (type) {
      case "get_admin_pass":
        return jsonp(callback, {
          status: "success",
          pass: getConfigValue("admin_pass") || DEFAULT_ADMIN_PASS
        });

      case "generate_qr":
        return jsonp(callback, handleGenerateQR_(params));

      case "mark_attendance":
        return jsonp(callback, markAttendance_(params));

      default:
        return jsonp(callback, {
          status: "error",
          message: "Invalid request type"
        });
    }
  } catch (err) {
    return jsonp(callback, {
      status: "error",
      message: err && err.message ? err.message : String(err)
    });
  }
}

/**
 * QR Generation Logic
 */
function handleGenerateQR_(params) {
  const session_id = String(params.session_id || "1").trim();
  const secret = getConfigValue("secret_key");
  const timestampSec = Math.floor(Date.now() / 1000);
  const token = Math.random().toString(36).substring(2, 10);

  const fullSig = generateSignature(session_id, timestampSec, token, secret);
  const shortSig = fullSig.substring(0, 16);
  const qrString = [session_id, timestampSec, token, shortSig].join("|");

  CacheService.getScriptCache().put(
    "qr_token_" + token,
    JSON.stringify({ session_id: session_id, timestamp: timestampSec, signature: shortSig }),
    QR_CACHE_TTL_SEC
  );

  return {
    status: "success",
    qr_payload: qrString,
    server_time: Date.now(),
    validity_sec: getQRValiditySec_(),
    grace_sec: QR_GRACE_SEC
  };
}

/**
 * Attendance marking logic
 *
 * Students sheet columns:
 * A = Roll No   B = Password   C = Name   D = Device ID
 * E = Flag      F = Attempt count   G = Last attempted device
 *
 * Attendance sheet columns:
 * A = DateTime  B = Student ID  C = Session ID  D = Token
 * E = Timestamp F = Scan Latency G = Device ID  H = Student Name
 * I = Latitude  J = Longitude
 */
function markAttendance_(data) {
  try {
    /* ---------- 1. DATA EXTRACTION ---------- */
    const student_id = String(data.student_id || "").trim();
    const session_id = String(data.session_id || "").trim();
    const token      = String(data.token      || "").trim();
    const signature  = String(data.signature  || "").trim();
    const device_id  = String(data.device_id  || "").trim();
    const lat        = String(data.lat        || "").trim();
    const lon        = String(data.lon        || "").trim();
    const t_gen      = Number(data.timestamp  || 0);
    const t_now      = Math.floor(Date.now() / 1000);

    if (!session_id || !token || !t_gen || !signature || !device_id) {
      return { status: "error", message: "Incomplete parameters" };
    }

    /* ---------- 2. TEMPORAL VALIDATION ---------- */
    const qrValidity = getQRValiditySec_();
    const qrAge = t_now - t_gen;

    if (qrAge < 0)                          return { status: "invalid_time",  message: "QR time invalid" };
    if (qrAge > (qrValidity + QR_GRACE_SEC)) return { status: "qr_stale",    message: "QR expired" };
    if (qrAge > 600)                         return { status: "expired",      message: "Session expired" };

    /* ---------- 3. SIGNATURE VALIDATION ---------- */
    const secret = getConfigValue("secret_key");
    const fullExpectedSig = generateSignature(session_id, t_gen, token, secret);

    if (signature !== fullExpectedSig.substring(0, 16)) {
      return { status: "invalid_sig", message: "Invalid signature" };
    }

    if (!CacheService.getScriptCache().get("qr_token_" + token)) {
      return { status: "qr_invalid", message: "QR not found in cache" };
    }

    /* ---------- 4. STUDENT + DEVICE MAPPING ---------- */
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const studentsSheet = ss.getSheetByName("Students");

    if (!studentsSheet) return { status: "error", message: "Students sheet missing" };

    const normalize = (val) => {
      if (typeof val === "number") val = val.toFixed(0);
      return String(val || "").replace(/[^a-z0-9]/gi, "").toLowerCase();
    };

    const normalizedDevice  = normalize(device_id);
    const normalizedInputId = normalize(student_id);

    const studentBundle = getStudentsBundle_(studentsSheet);
    const deviceMap = studentBundle.deviceMap;
    const rollMap   = studentBundle.rollMap;

    let studentName           = "";
    let foundMatch            = false;
    let finalStudentId        = "";
    let matchedRow            = -1;
    let needsFirstRegistration = false;
    let deviceChanged          = false;

    /* Case 1: Device already registered and matches */
    if (normalizedDevice && Object.prototype.hasOwnProperty.call(deviceMap, normalizedDevice)) {
      const rec  = deviceMap[normalizedDevice];
      finalStudentId = rec.roll;
      studentName    = rec.name;
      matchedRow     = rec.row;
      deviceChanged  = false;
      foundMatch     = true;
    }

    /* Case 2 / 3: Roll no provided */
    else if (normalizedInputId && Object.prototype.hasOwnProperty.call(rollMap, normalizedInputId)) {
      const rec  = rollMap[normalizedInputId];
      matchedRow     = rec.row;
      finalStudentId = rec.roll;
      studentName    = rec.name;
      deviceChanged  = !!(rec.device && rec.device !== normalizedDevice);
      needsFirstRegistration = !rec.device;
      foundMatch     = true;

      if (deviceChanged) {
        const lock = LockService.getScriptLock();
        try {
          if (lock.tryLock(2000)) {
            const prev = Number(studentsSheet.getRange(matchedRow, 6).getValue() || 0);
            studentsSheet.getRange(matchedRow, 5).setValue("⚠️ Device Changed");
            studentsSheet.getRange(matchedRow, 6).setValue(prev + 1);
            studentsSheet.getRange(matchedRow, 7).setValue(device_id);
          }
        } finally {
          try { lock.releaseLock(); } catch(e) {}
        }
      }
    }

    if (!foundMatch) {
      return { status: "register_required", message: "Device not registered" };
    }

    /* ---------- 5. FIRST-TIME DEVICE REGISTRATION ---------- */
    if (needsFirstRegistration) {
      const regLock = LockService.getScriptLock();
      try {
        if (!regLock.tryLock(2000)) {
          return { status: "busy", message: "Please scan again" };
        }
        const existingDevice = normalize(studentsSheet.getRange(matchedRow, 4).getValue());
        if (!existingDevice) {
          studentsSheet.getRange(matchedRow, 4).setValue(device_id);
          invalidateStudentsCache_();
        } else if (existingDevice !== normalizedDevice) {
          return handleDeviceMismatchAfterRace_(studentsSheet, matchedRow, device_id);
        }
      } finally {
        try { regLock.releaseLock(); } catch(e) {}
      }
    }

    /* ---------- 6. DUPLICATE PREVENTION ---------- */
    const attendanceSheet = getOrCreateSheet_("Attendance");
    const cache = CacheService.getScriptCache();

    if (attendanceSheet.getLastRow() === 0) {
      ensureAttendanceHeader_(attendanceSheet);
      cache.remove("last_row_att");
    }

    const dupKey = "att_" + session_id + "_" + finalStudentId;
    let isDuplicate = false;

    if (attendanceSheet.getLastRow() <= 1) {
      isDuplicate = false;
    } else if (cache.get(dupKey)) {
      isDuplicate = true;
    } else {
      cache.put(dupKey, "1", DUPLICATE_WINDOW_SEC);
    }

    /* ---------- 7. RECORD ENTRY ---------- */
    const row = [
      new Date(), finalStudentId, session_id, token,
      t_gen, qrAge + "s", device_id, studentName, lat, lon
    ];

    const writeLock = LockService.getScriptLock();
    if (!writeLock.tryLock(2000)) {
      return { status: "busy", message: "Please scan again" };
    }

    try {
      const lastRow = Math.max(attendanceSheet.getLastRow(), 1);
      attendanceSheet.getRange(lastRow + 1, 1, 1, row.length).setValues([row]);
      cache.put("last_row_att", String(lastRow + 1), 300);
    } finally {
      try { writeLock.releaseLock(); } catch(e) {}
    }

    /* ---------- 8. RETURN ---------- */
    return {
      status: "success",
      roll: finalStudentId,
      name: studentName,
      duplicate: isDuplicate,
      qr_age: qrAge,
      device_changed: deviceChanged
    };

  } catch (err) {
    return {
      status: "error",
      message: err && err.message ? err.message : String(err)
    };
  }
}

/* ================= DEVICE MISMATCH HANDLERS ================= */

function handleDeviceMismatch_(studentsSheet, row, device_id) {
  const lock = LockService.getScriptLock();
  try {
    if (!lock.tryLock(2000)) return { status: "busy", message: "Please scan again" };
    const prev = Number(studentsSheet.getRange(row, 6).getValue() || 0);
    studentsSheet.getRange(row, 5).setValue("⚠️ Device Changed");
    studentsSheet.getRange(row, 6).setValue(prev + 1);
    studentsSheet.getRange(row, 7).setValue(device_id);
    return { status: "device_already_registered", message: "⚠️ Different device detected. Attempt recorded." };
  } finally {
    try { lock.releaseLock(); } catch(e) {}
  }
}

function handleDeviceMismatchAfterRace_(studentsSheet, row, device_id) {
  const prev = Number(studentsSheet.getRange(row, 6).getValue() || 0);
  studentsSheet.getRange(row, 5).setValue("⚠️ Device Changed");
  studentsSheet.getRange(row, 6).setValue(prev + 1);
  studentsSheet.getRange(row, 7).setValue(device_id);
  return { status: "device_already_registered", message: "⚠️ Different device detected. Attempt recorded." };
}

/* ================= STUDENT CACHE ================= */

function getStudentsBundle_(studentsSheet) {
  const cache = CacheService.getScriptCache();
  const cacheKey = "students_bundle_v1";
  const cached = cache.get(cacheKey);
  if (cached) return JSON.parse(cached);

  const lastRow = studentsSheet.getLastRow();
  const values = lastRow >= 2
    ? studentsSheet.getRange(2, 1, lastRow - 1, 4).getValues()
    : [];

  const deviceMap = {};
  const rollMap   = {};

  for (let i = 0; i < values.length; i++) {
    const rowNum = i + 2;
    const roll   = normalizeStatic_(values[i][0]);
    const name   = String(values[i][2] || "").trim();
    const device = normalizeStatic_(values[i][3]);

    const rec = {
      row:    rowNum,
      roll:   String(values[i][0] || "").trim(),
      name:   name,
      device: device
    };

    if (roll)   rollMap[roll]     = rec;
    if (device) deviceMap[device] = rec;
  }

  const bundle = { rollMap, deviceMap };
  cache.put(cacheKey, JSON.stringify(bundle), STUDENT_CACHE_TTL_SEC);
  return bundle;
}

function invalidateStudentsCache_() {
  CacheService.getScriptCache().remove("students_bundle_v1");
}

function normalizeStatic_(val) {
  if (typeof val === "number") val = val.toFixed(0);
  return String(val || "").replace(/[^a-z0-9]/gi, "").toLowerCase();
}

/* ================= CORE HELPERS ================= */

function generateSignature(session_id, timestamp, token, secret) {
  const raw = session_id + "|" + timestamp + "|" + token + "|" + secret;
  const hash = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, raw, Utilities.Charset.UTF_8);
  return hash.map(b => { const v = (b < 0 ? b + 256 : b).toString(16); return v.length === 1 ? "0" + v : v; }).join("");
}

function jsonp(callback, obj) {
  return ContentService
    .createTextOutput(callback + "(" + JSON.stringify(obj) + ")")
    .setMimeType(ContentService.MimeType.JAVASCRIPT);
}

function getSheet_(name) {
  return SpreadsheetApp.getActiveSpreadsheet().getSheetByName(name);
}

function getOrCreateSheet_(name) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  return ss.getSheetByName(name) || ss.insertSheet(name);
}

function ensureAttendanceHeader_(sheet) {
  if (sheet.getLastRow() === 0) {
    sheet.appendRow(["DateTime","Student ID","Session ID","Token","Timestamp","Scan Latency","Device ID","Student Name","Latitude","Longitude"]);
  }
}

function getConfigValue(key) {
  const cache = CacheService.getScriptCache();
  const cacheKey = "config_map_v1";
  let configMap = cache.get(cacheKey);

  if (configMap) {
    configMap = JSON.parse(configMap);
    return String(configMap[key] || "").trim();
  }

  const sheet = getSheet_("Config");
  if (!sheet) return "";

  const data = sheet.getDataRange().getValues();
  configMap = {};
  for (let i = 0; i < data.length; i++) {
    const k = String(data[i][0] || "").trim();
    const v = String(data[i][1] || "").trim();
    if (k) configMap[k] = v;
  }

  cache.put(cacheKey, JSON.stringify(configMap), CONFIG_CACHE_TTL_SEC);
  return String(configMap[key] || "").trim();
}

function getQRValiditySec_() {
  const val = Number(getConfigValue("qr_validity_sec") || DEFAULT_QR_VALIDITY_SEC);
  return isFinite(val) && val > 0 ? Math.floor(val) : DEFAULT_QR_VALIDITY_SEC;
}
